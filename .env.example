# https://docs.silverstripe.org/en/4/getting_started/environment_management/
# LOCAL DEV ONLY — every value here is fake. Real dev/prod secrets live in
# AWS Parameter Store (SecureString), never in git or local files.

# DB (docker compose: server is overridden to "database")
SS_DATABASE_CLASS="MySQLDatabase"
SS_DATABASE_SERVER="127.0.0.1"
SS_DATABASE_USERNAME="root"
SS_DATABASE_PASSWORD="local-dev-only"
SS_DATABASE_NAME="citanz"

SS_ERROR_LOG="silverstripe.log"
SS_ENVIRONMENT_TYPE="dev"
SS_BASE_URL="http://localhost:8080"
SS_TRUSTED_PROXY_IPS="*"

SS_DEFAULT_ADMIN_USERNAME="admin"
SS_DEFAULT_ADMIN_PASSWORD="local-admin-change-me"

SS_SEND_ALL_EMAILS_TO="dev-null@example.com"
SS_SEND_ALL_EMAILS_FROM="dev-null@example.com"

# OAuth: generate locally with
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
OAUTH_ENCRYPTION_KEY="REPLACE_ME_LOCAL_ONLY"

# Leave AWS_* unset locally -> assets stay in public/assets (no S3).
# AWS_REGION=""
# AWS_BUCKET_NAME=""

# SS_FORCE_SSL=true
# SS_FORCE_WWW=true
# SS_USE_BASIC_AUTH=true
